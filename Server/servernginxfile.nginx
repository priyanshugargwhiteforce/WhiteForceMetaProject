# 1. HTTP to HTTPS Redirect
server {
    if ($host = wfadmanager.astro-buddy.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name wfadmanager.astro-buddy.in;
    return 301 https://$host$request_uri;


}

# 2. HTTPS Server Configuration
server {
    listen 443 ssl http2;
    server_name wfadmanager.astro-buddy.in;

    # SSL Certificates (Certbot dwara generated)
    ssl_certificate /etc/letsencrypt/live/wfadmanager.astro-buddy.in/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/wfadmanager.astro-buddy.in/privkey.pem; # managed by Certbot

    # Best Practice SSL Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Frontend React static files
    location / {
        root /var/www/wf_ad_manager/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # WhatsApp Chatbot Webhook (Port 8001)
    location /api/whatsapp/webhook {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend API Proxy (Port 8085)
    location /api {
        proxy_pass http://127.0.0.1:8085;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

}
